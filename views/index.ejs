<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css"/>
    <script src="bootstrap/dist/js/bootstrap.min.js"></script>
  </head>
  <body>
    <!-- Include header tag used to dynamically input the nav bars for each page directly from header.ejs file
      without manually pasting navbar code for each page-->
    <%- include('header') %>
    <!-- Flex wrapper to center home content in content section-->
     <div class="container d-flex flex-column justify-content-center 
     align-items-center text-center pb-5" style="min-height: 82vh;">
     <!-- Main Name Title-->
      <div class="p-4 p-md-5 bg-white rounded shadow-sm border" style="max-width: 720px;">
        <h1 class="display-4 fw-bold mb-3">Shakir Hossain</h1>
        <p class="lead text-secondary mb-4">
          Welcome to my portfolio! My name is Shakir Hossain, I am an IT Networking and Security
          student at Ontario Tech University. This is my Express website, click any of the buttons 
          below to check out my projects, know a little about me, or contact me for any further information!
        </p>
        <!--Navigation Buttons to Main Sections for home screen, using flexible 
        containers to provide neat orientation-->
        <div class="d-flex flex-wrap justify-content-center gap-3">
          <a href="/projects" class="btn btn-dark btn-lg px-4">View Projects</a>
          <a href="/about" class="btn btn-dark btn-lg px-4">About Me</a>
          <a href="/contact" class="btn btn-dark btn-lg px-4">Contact Me</a>
        </div>
      </div>



    </div>
    <%- include('footer') %>
  </body>
</html>
