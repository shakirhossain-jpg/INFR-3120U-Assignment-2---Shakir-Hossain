<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css"/>
    <script src="bootstrap/dist/js/bootstrap.min.js"></script>
  </head>
  <body>
    <%- include('header') %>
    <!--Bootstrap container centers and provide padding to left/right columns for neat orientation-->
    <div class="container my-4 pb-5">
      <h1 class="text-center my-4">About Me</h1>
    
      <!--Left Column: Video/Poster Contet-->
      <div id="left-column">
        <video controls width="450" height="350" poser="/images/portrait.jpg" preload="auto">
          <source src="/images/About-Me.mp4" type="video/mp4">
        </video>
      </div>

      <div id="right-column">
        <h2>Who Am I</h2>
        <p>My name is Shakir Hossain, I am 19 years old. I am a student
          at Ontario Tech University studying IT Networking and Security.
          I am born in Dhaka, Bangladesh, and moved to Canada when I was a year old.
          Some things I like to do in my free time are playing sports with friends 
          (Soccer, Basketball, etc), play video-games, and watch movies/TV shows.
        </p>
      </div>
    </div>
    <%- include('footer') %>
  </body>
</html>
